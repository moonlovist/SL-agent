# ── Data & outputs (mounted at runtime) ──
data/
output/
outputs/
input/

# ── Git ──
.git/
.gitignore
.gitattributes

# ── Python artifacts ──
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo

# ── Project tooling ──
.claude/
.qoder/
.codeartsdoer/
.agents/
.debugger/

# ── Environment files (keep secrets out of image) ──
.env
.env.*

# ── Logs ──
log/
*.log

# ── Node (if present) ──
node_modules/
package-lock.json

